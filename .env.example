# =============================================================================
# Chargily Pay — Shopify App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — only .env.example belongs in the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# Shopify App Credentials
# Found in: Shopify Partner Dashboard → Apps → Your App → App setup
# -----------------------------------------------------------------------------
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# The public URL of your app (ngrok URL in dev, your domain in production)
# Example: https://abc123.ngrok-free.app
SHOPIFY_APP_URL=https://your-app-url.example.com

# OAuth scopes — must match shopify.app.toml
SCOPES=read_payment_mandate

# -----------------------------------------------------------------------------
# Database
# SQLite file path for development. Use a real database URL in production.
# Example (PostgreSQL): postgresql://user:password@localhost:5432/chargily_db
# -----------------------------------------------------------------------------
DATABASE_URL=file:./dev.db

# -----------------------------------------------------------------------------
# Chargily Pay (filled by each merchant via the app config page)
# These are NOT set here — they are stored per-merchant in the database.
# Documented here for reference only.
#
# CHARGILY_API_KEY      → Chargily Pay Dashboard → Developers Corner → Secret Key
# CHARGILY_WEBHOOK_SECRET → Chargily Pay Dashboard → Developers Corner → Webhook Secret
# -----------------------------------------------------------------------------
